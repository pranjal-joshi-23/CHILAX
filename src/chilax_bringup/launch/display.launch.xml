<launch>
    <let name="urdf_path" value="$(find-pkg-share chilax_simulation)/urdf/main.urdf.xacro" />
    <let name="rviz_config_path" value="$(find-pkg-share chilax_bringup)/rviz/chilax.rviz" />
    <let name="gazebo_config_path" value="$(find-pkg-share chilax_bringup)/config/gazebo_bridge.yaml" />
    <let name="world_path" value="$(find-pkg-share chilax_bringup)/world/testing.sdf" />
    <let name="chilax_config_path" value="$(find-pkg-share chilax_bringup)/config/parameters.yaml" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world_path) -r" />
        <!-- <arg name="gz_args" value="empty.sdf -r" /> -->
    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -z 0.5" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)" />
    </node>

    <!-- <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" /> -->

    <node pkg="chilax_controlls" exec="joint_position_publisher" />
    <!-- <node pkg="chilax_controlls" exec="main"> -->
    <node pkg="chilax_controlls" exec="test_controller">
        <param from="$(var chilax_config_path)" />
    </node>
    <node pkg="chilax_controlls" exec="user_keyboard_input" />
    <node pkg="chilax_controlls" exec="keyboard_controller" />

    <node pkg="chilax_vision" exec="vision" />

    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" />
</launch>