<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.01 0.05 0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="sensor"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.01 0.05 0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <xacro:box_inertia m="0.01" x="0.01" y="0.05" z="0.05" o_xyz="0 0 0" o_rpy="0 0 0" />
    </link>

    <joint name="body_camera_joint" type="fixed">
        <parent link="front_body_link"/>
        <child link="camera_link"/>
        <origin xyz="${front_body_length / 2.0 + 0.005} 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>

            <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
                <width>640</width>
                <height>480</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.1</near>
                <far>100</far>
            </clip>
            </camera>

            <gz_frame_id>camera_link</gz_frame_id>
            <topic>/camera/image_raw</topic>
        </sensor>
    </gazebo>

</robot>