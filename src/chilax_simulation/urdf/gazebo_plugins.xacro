    <!-- <gazebo>
        <plugin
            filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">

            <odom_frame>odom</odom_frame>
            <robot_base_frame>base_link</robot_base_frame>

            <odom_publish_frequency>50</odom_publish_frequency>

        </plugin>
    </gazebo> -->

    <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system" 
            name="gz::sim::systems::JointStatePublisher">
            <joint_name>body_front_left_socket_joint</joint_name>
            <joint_name>body_front_right_socket_joint</joint_name>
            <joint_name>body_back_left_socket_joint</joint_name>
            <joint_name>body_back_right_socket_joint</joint_name>
            <joint_name>front_left_leg_socket_joint</joint_name>
            <joint_name>front_left_leg_joint</joint_name>
            <joint_name>front_right_leg_socket_joint</joint_name>
            <joint_name>front_right_leg_joint</joint_name>
            <joint_name>back_left_leg_socket_joint</joint_name>
            <joint_name>back_left_leg_joint</joint_name>
            <joint_name>back_right_leg_socket_joint</joint_name>
            <joint_name>back_right_leg_joint</joint_name>
        </plugin>
    </gazebo>

</robot>