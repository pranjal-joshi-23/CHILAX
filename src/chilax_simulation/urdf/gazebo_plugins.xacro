            <joint_name>front_left_leg_socket_joint</joint_name>
            <p_gain>20.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0.5</d_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>front_left_leg_joint</joint_name>
            <p_gain>20.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0.5</d_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
