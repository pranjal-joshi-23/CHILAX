<?xml version="3.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo reference="front_left_feet_link">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
    </gazebo>
    <gazebo reference="front_right_feet_link">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
    </gazebo>
    <gazebo reference="back_left_feet_link">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
    </gazebo>
    <gazebo reference="back_right_feet_link">
        <mu1>1.5</mu1>
        <mu2>1.5</mu2>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>body_front_left_socket_joint</joint_name>
            <p_gain>20.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0.5</d_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>body_front_right_socket_joint</joint_name>
            <p_gain>20.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0.5</d_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>body_back_left_socket_joint</joint_name>
            <p_gain>20.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0.5</d_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
            <joint_name>body_back_right_socket_joint</joint_name>
            <p_gain>20.0</p_gain>
            <i_gain>0</i_gain>
            <d_gain>0.5</d_gain>
        </plugin>
    </gazebo>

    <gazebo>
        <plugin
            filename="gz-sim-joint-position-controller-system"
